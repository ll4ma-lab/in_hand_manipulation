# This message stores a 2d ellipse in analytical form, also gives a projection matrix to project 3D points into the # plane of the ellipse
# a= major axis length
# f_1,f_2= foci locations
# proj_mat= projection matrix
#

float64 a
float64[] c
float64[] f_1
float64[] f_2
float64[] proj_mat
float64[] plane_normal
float64 plane_d
