Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /RobotModel1
        - /Trajectory1
        - /Trajectory1/Links1
      Splitter Ratio: 0.5
    Tree Height: 750
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /2D Nav Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.588679016
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: false
      Line Style:
        Line Width: 0.0299999993
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: false
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: false
      Visual Enabled: true
    - Class: moveit_rviz_plugin/Trajectory
      Color Enabled: false
      Enabled: true
      Interrupt Display: false
      Links:
        All Links Enabled: false
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        allegro_mount:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: false
        index_link_0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        index_link_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        index_link_2:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        index_link_3:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        index_tip:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        middle_link_0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        middle_link_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        middle_link_2:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        middle_link_3:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        middle_tip:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        palm_link:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        ring_link_0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: false
        ring_link_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: false
        ring_link_2:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: false
        ring_link_3:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: false
        ring_tip:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: false
        thumb_link_0:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        thumb_link_1:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        thumb_link_2:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        thumb_link_3:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
        thumb_tip:
          Alpha: 1
          Show Axes: false
          Show Trail: false
          Value: true
      Loop Animation: true
      Name: Trajectory
      Robot Alpha: 1
      Robot Color: 150; 50; 150
      Robot Description: robot_description
      Show Robot Collision: false
      Show Robot Visual: true
      Show Trail: false
      State Display Time: 0.1 s
      Trail Step Size: 1
      Trajectory Topic: planner/in_grasp_traj
      Value: true
  Enabled: true
  Global Options:
    Background Color: 120; 120; 120
    Fixed Frame: palm_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 0.268773854
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.0599999987
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.0608693734
        Y: 0.00430810591
        Z: 1.00864436e-05
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.0500000007
      Name: Current View
      Near Clip Distance: 0.00999999978
      Pitch: -1.37479651
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 1.57540107
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 1056
  Hide Left Dock: true
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Trajectory - Slider:
    collapsed: false
  Views:
    collapsed: true
  Width: 1920
  X: 1920
  Y: 24
