<?xml version="1.0"?>
<launch>
<param name="robot_description" textfile="$(find in_grasp_manipulation)/urdf/allegro.urdf"/>

  <node name="jointState2tf_right"
        pkg="robot_state_publisher"
        type="state_publisher">

    <remap from="/joint_states" to="/allegro_hand_right/joint_states"/>
  </node>
<!--node pkg="rviz" type="rviz" output="screen" name="rviz" 
      args="-d $(find in_grasp_manipulation)/config/allegro.rviz" /-->

</launch>
